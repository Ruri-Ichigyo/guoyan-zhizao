# Database configuration
POSTGRES_DB=gyz
POSTGRES_USER=gyz
POSTGRES_PASSWORD=gyz123
DATABASE_URL=postgres://gyz:gyz123@postgres:5432/gyz

# Redis cache
REDIS_URL=redis://redis:6379
CACHE_TTL_SECONDS=900

# Backend service
BIND_ADDRESS=0.0.0.0:8080
AI_SERVICE_URL=http://ai:8002
RUST_LOG=info
JWT_SECRET=development-secret-change-me
JWT_TTL_SECONDS=3600
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
ADMIN_ROLE=admin

# Frontend build-time variables
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_APP_NAME=果蔬智造核心平台
VITE_APP_VERSION=1.0.0

# Local development helpers
DEV_DATABASE_URL=postgres://gyz:gyz123@localhost:5432/gyz
DEV_REDIS_URL=redis://localhost:6379
DEV_AI_SERVICE_URL=http://localhost:8002

# LLM API Configuration (SiliconFlow)
LLM_API_URL=https://api.siliconflow.cn/v1/messages
LLM_API_KEY=your-api-key-here
LLM_MODEL=tencent/Hunyuan-MT-7B
LLM_MAX_TOKENS=8192
LLM_TIMEOUT_SECONDS=10

# MCP Server Configuration
MCP_SERVER_URL=http://localhost:3000
MCP_ALLOWED_TABLES=uploads,results
MCP_MAX_ROWS=1000

# Chat Configuration
CHAT_CONTEXT_WINDOW=10
CHAT_SUMMARIZE_AFTER=10
CHAT_POLLING_INTERVAL_MS=2000
VITE_CHAT_POLLING_INTERVAL=2000
